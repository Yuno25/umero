generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      =  env("MONGODB_URI")
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  username       String?
  contact        String?
  password       String?
  emailVerified  Boolean  @default(false)

  otp            String?
  otpExpiry      DateTime?
  lastAuthAction String?

  avatar          String?

  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @updatedAt

  @@map("users")
}

model Lister {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  email  String?
  userId String? @db.ObjectId

  @@map("listers") // match your DB
}

model Renter {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  email  String?
  userId String? @db.ObjectId

  @@map("renters")
}