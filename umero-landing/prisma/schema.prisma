generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      =  env("MONGODB_URI")
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  username       String?
  contact        String?
  password       String?
  emailVerified  Boolean  @default(false)
  phone   String?
city    String?
state   String?
address String?
gender  String?
age     Int?

  otp            String?
  otpExpiry      DateTime?
  lastAuthAction String?

  avatar          String?

  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @updatedAt

  @@map("users")
}

model Lister {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  email  String?
  userId String? @db.ObjectId

  @@map("listers") // match your DB
}

model Renter {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  email  String?
  userId String? @db.ObjectId

  @@map("renters")
}
model Booking {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId

  spaceId      String
  spaceName    String
  hostEmail    String
  renterId     String
  renterEmail  String

  bookingDate  String
  startTime    String
  endTime      String

  totalHours   Float
  totalPrice   Int

  status       String   @default("PENDING")

  createdAt    DateTime @default(now())
}